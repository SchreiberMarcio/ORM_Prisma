generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String @map("nome") @db.VarChar(100)
  age Int @map("idade") 
  email String @unique @db.VarChar(50)
  password String @map("senha")
  githubLink String? @map("link_github") @db.VarChar(50)

  createAt DateTime @default(now()) @map("criado_em")
  updateAt DateTime @updatedAt @map("atualizado_em")

  @@map("usuarios")
}

enum Disponibilidade {
  SIM
  NAO
}

model Store {
  cnpj      String   @id @db.Char(14)
  name      String   @db.VarChar(50)
  segment  String?  @default("alimentacao")
  address   String   
  phone     String?  
  quantityBranches Int
  dateHourOpen DateTime @map("data_hour_open") @db.Timestamp()

  createdAt DateTime @default(now()) @map("created_at") @db.Date()
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stores")
}

model Supplier {
  id     String @id @default(uuid()) @db.Uuid
  name   String @db.VarChar(50)
  email  String @db.VarChar(100)
  rating Decimal    @db.Decimal()

  createdAt DateTime @default(now()) @map("created_at") @db.Date()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("suppliers")
}

enum Available {
  Yes
  No
}